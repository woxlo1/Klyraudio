{
  "name": "klyraudio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI audio creation studio",
  "license": "GPL-3.0-only",
  "workspaces": [
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @klyraudio/web",
    "dev:web": "npm run dev --workspace @klyraudio/web",
    "dev:desktop": "npm run dev --workspace @klyraudio/desktop",
    "build": "npm run build --workspace @klyraudio/web",
    "build:desktop": "npm run build --workspace @klyraudio/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "api:install": "python -m pip install -r services/api/requirements.txt",
    "api:dev": "python -m uvicorn klyraudio_api.app:create_app --factory --host 127.0.0.1 --port 8765 --app-dir services/api",
    "api:test": "python -m pytest services/api/tests"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
